# Growfit FA — web app environment
# Copy to .env.local and fill in. The root .env.example covers the Expo app.

# ── Supabase ──────────────────────────────────────────────
# Settings > API in your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Site ──────────────────────────────────────────────────
# Used to build absolute links (shared passports, shared plays)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AI ────────────────────────────────────────────────────
# Required for every AI feature: coach assistant, session planner, reports,
# tactical analysis, and reading players off a registration PDF.
GEMINI_API_KEY=your-gemini-api-key

# Model ids are optional — defaults live in src/lib/ai-models.ts. Set these
# when Google retires a model, or to trade cost against quality.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_MODEL_DOC=gemini-3.6-flash
